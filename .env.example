# Database (required). Example for local Postgres:
# DATABASE_URL=postgresql://user:password@localhost:5432/vinaapaco

DATABASE_URL=

# Session secret (required in production: set a long random string, e.g. 32+ chars).
# Do not use the default in production.
SESSION_SECRET=your-session-secret-at-least-32-chars

# Optional: port for the server (default 5000)
# PORT=5000

# Optional: staff user created only in non-production if not present in DB
# STAFF_USERNAME=admin
# STAFF_PASSWORD=admin

# NODE_ENV is set by scripts (development / production)
